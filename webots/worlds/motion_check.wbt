#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/PingPongFollowerRobot.proto"

WorldInfo {
  info [
    "Minimal world for verifying that PingPongFollowerRobot drives and rotates."
    "No ball and no arena walls - those arrive with the main world in PROMPT 3."
  ]
  title "Ping Pong Follower - motion check"
  basicTimeStep 16
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction 0.05
    }
  ]
}
Viewpoint {
  orientation -0.35 0.30 0.89 1.9
  position -1.4 -1.1 1.1
}
Background {
  skyColor [
    0.6 0.7 0.85
  ]
}
DirectionalLight {
  direction 0.5 -0.6 -1
  intensity 3
  castShadows TRUE
}
Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.85 0.85 0.85
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 10 10
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 10 10
  }
}
PingPongFollowerRobot {
  translation 0 0 0
  rotation 0 0 1 0
  controller "motion_check"
  supervisor TRUE
}
