#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/PingPongFollowerRobot.proto"

# Main world: 4 m x 4 m walled arena, one orange ping-pong ball, one follower robot.
#
# Repeatable initial configuration. Every pose below is explicit, the timestep is fixed,
# and nothing is randomised, so a reset reproduces the same run. Do not save the world
# from the GUI after a simulation has moved anything - that would bake the drifted state
# into these coordinates.
#
# Placement (measured against config.py, verified by the world_check controller):
#   robot origin       (-1.000, 0, 0)  facing +X
#   camera             (-0.900, 0, 0.085)
#   ball centre        ( 0.300, 0, 0.020)
#   camera-to-ball     1.200 m horizontally
#
# At that range a 40 mm ball subtends r = f*D/(2*Z) = 585.8*0.04/2.4 = 9.8 px and sits
# 3.1 deg (about 32 px) below the optical axis - comfortably inside the 0.78 rad vertical
# FOV. The 1.0-1.5 m band was chosen deliberately: at the 3 m the specification suggests,
# the ball is only ~3.9 px in radius and circularity filtering stops being meaningful.
#
# Floor and walls are deliberately desaturated grey. Orange segmentation keys on
# saturation as well as hue, so a neutral background cannot produce false positives.

WorldInfo {
  info [
    "Autonomous object-following vehicle - ping pong ball tracking."
  ]
  title "Ping Pong Follower"
  basicTimeStep 16
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction 0.05
    }
    ContactProperties {
      material1 "ball"
      material2 "default"
      coulombFriction 0.7
      rollingFriction 0.03 0 0
      bounce 0.3
    }
  ]
}
Viewpoint {
  orientation -0.28 0.35 0.89 1.75
  position -2.6 -2.2 2.0
}
Background {
  skyColor [
    0.55 0.62 0.72
  ]
}
DirectionalLight {
  ambientIntensity 0.55
  direction 0.4 -0.5 -1
  intensity 2.2
  castShadows TRUE
}
DirectionalLight {
  ambientIntensity 0.3
  direction -0.5 0.4 -0.8
  intensity 1.0
}

# ---------------- floor ----------------
DEF FLOOR Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.74 0.75 0.78
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 4 4
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 4 4
  }
}

# ---------------- walls ----------------
DEF WALL_NORTH Solid {
  translation 0 2.025 0.15
  children [
    DEF WALL_LONG Shape {
      appearance PBRAppearance {
        baseColor 0.52 0.55 0.60
        roughness 1
        metalness 0
      }
      geometry Box {
        size 4.1 0.05 0.30
      }
    }
  ]
  name "wall north"
  boundingObject USE WALL_LONG
}
DEF WALL_SOUTH Solid {
  translation 0 -2.025 0.15
  children [
    USE WALL_LONG
  ]
  name "wall south"
  boundingObject USE WALL_LONG
}
DEF WALL_EAST Solid {
  translation 2.025 0 0.15
  children [
    DEF WALL_SHORT Shape {
      appearance PBRAppearance {
        baseColor 0.52 0.55 0.60
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.05 4.0 0.30
      }
    }
  ]
  name "wall east"
  boundingObject USE WALL_SHORT
}
DEF WALL_WEST Solid {
  translation -2.025 0 0.15
  children [
    USE WALL_SHORT
  ]
  name "wall west"
  boundingObject USE WALL_SHORT
}

# ---------------- ping-pong ball ----------------
# 40 mm diameter, 2.7 g - regulation values. Light enough to be nudged if the robot
# reaches it, which is realistic and is why the controller stops short.
DEF BALL Solid {
  translation 0.300 0 0.020
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0.35 0.02
        roughness 0.45
        metalness 0
      }
      geometry Sphere {
        radius 0.020
        subdivision 3
      }
    }
  ]
  name "ping_pong_ball"
  contactMaterial "ball"
  boundingObject Sphere {
    radius 0.020
  }
  physics Physics {
    density -1
    mass 0.0027
  }
}

# ---------------- robot ----------------
# "ball_follower" is the active controller from PROMPT 4 onward. The world_check
# controller still exists and can be selected temporarily to re-verify the arena.
# supervisor stays TRUE so the evaluation scripts can move the ball in later phases;
# ball_follower itself only constructs a plain Robot and never uses supervisor calls.
DEF ROBOT PingPongFollowerRobot {
  translation -1.000 0 0
  rotation 0 0 1 0
  controller "ball_follower"
  supervisor TRUE
}
